local function getMM2Role(player)
	if not player then return "Innocent" end
	local backpack = player:FindFirstChild("Backpack")
	local char = player.Character
	if (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
		return "Murder"
	elseif (backpack and backpack:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun")) then
		return "Sheriff"
	end
	if player:FindFirstChild("PlayerData") and player.PlayerData:FindFirstChild("Role") then
		return player.PlayerData.Role.Value
	end
	return "Innocent"
end

local function updateRolesList()
	for _, child in ipairs(RolesScroll:GetChildren()) do
		if child:IsA("TextLabel") then child:Destroy() end
	end
	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		local role = getMM2Role(p)
		local roleText = "[Невиновный]"
		local color = Color3.fromRGB(150, 150, 150)
		if role == "Murder" then
			roleText = "[УБИЙЦА]"
			color = Color3.fromRGB(255, 50, 50)
		elseif role == "Sheriff" then
			roleText = "[ШЕРИФ]"
			color = Color3.fromRGB(50, 150, 255)
		end
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, -10, 0, 30)
		lbl.BackgroundTransparency = 0.9
		lbl.BackgroundColor3 = color
		lbl.Text = "  " .. p.Name .. " — " .. roleText
		lbl.TextColor3 = color
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Font = Enum.Font.GothamSemibold
		lbl.TextSize = 14
		lbl.Parent = RolesScroll
		Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 4)
		count = count + 1
	end
	RolesScroll.CanvasSize = UDim2.new(0, 0, 0, count * 36)
end

task.spawn(function()
	while task.wait(1) do
		if ScreenGui and ScreenGui.Parent then updateRolesList() else break end
	end
end)

local function refreshHitboxes()
for _, p in ipairs(Players:GetPlayers()) do
if p ~= LocalPlayer and p.Character then
local head = p.Character:FindFirstChild("Head")
if head and head:IsA("BasePart") then
if HitboxEnabled then
head.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
head.Transparency = HitboxTransparency
head.Color = Color3.fromRGB(0, 255, 170)
head.Material = Enum.Material.ForceField
head.CanCollide = false
else
head.Size = Vector3.new(2, 1, 1)
head.Transparency = 0
head.Material = Enum.Material.Plastic
head.CanCollide = true
end
end
end
end
end
