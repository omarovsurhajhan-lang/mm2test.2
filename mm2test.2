local function applyEsp(player)
if player == LocalPlayer then return end
local char = player.Character
if char and char:WaitForChild("HumanoidRootPart", 5) then
if not char:FindFirstChild("ESPHighlight") and EspEnabled then
local highlight = Instance.new("Highlight")
highlight.Name = "ESPHighlight"
highlight.FillColor = Color3.fromRGB(255, 255, 255)
highlight.OutlineColor = Color3.fromRGB(0, 255, 170)
highlight.FillTransparency = 0.6
highlight.Parent = char
end
end
end
EspToggle.MouseButton1Click:Connect(function()
EspEnabled = not EspEnabled
EspToggle.Text = EspEnabled and "ESP (ВХ): АКТИВИРОВАН" or "ESP (ВХ): ОТКЛЮЧЕН"
EspToggle.BackgroundColor3 = EspEnabled and Color3.fromRGB(0, 210, 130) or Color3.fromRGB(235, 65, 65)
for _, p in ipairs(Players:GetPlayers()) do
if not EspEnabled and p.Character and p.Character:FindFirstChild("ESPHighlight") then
p.Character.ESPHighlight:Destroy()
elseif EspEnabled then
applyEsp(p)
end
end
end)
