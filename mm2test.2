local function localGiveItem(itemName)
local targetTool = nil
for _, p in ipairs(Players:GetPlayers()) do
if p.Character and p.Character:FindFirstChild(itemName) then
targetTool = p.Character[itemName]
break
elseif p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild(itemName) then
targetTool = p.Backpack[itemName]
break
end
end
if not targetTool then
targetTool = ReplicatedStorage:FindFirstChild(itemName) or (ReplicatedStorage:FindFirstChild("Tools") and ReplicatedStorage.Tools:FindFirstChild(itemName))
end
if targetTool and LocalPlayer:FindFirstChild("Backpack") then
local clone = targetTool:Clone()
clone.Parent = LocalPlayer.Backpack
end
end
